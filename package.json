{
  "name": "paradoxdb",
  "type": "module",
  "author": "panevg",
  "version": "0.0.6",
  "scripts": {
    "build": "bun run ./build.js"
  },
  "build": {
    "entrypoint": "./src/index.ts",
    "filename": "paradox",
    "outdir": "./build",
    "targets": [
      "bun-linux-x64"
    ],
    "clean_outdir": true
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/signale": "^1.4.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "env-paths": "^4.0.0",
    "signale": "^1.4.0",
    "smol-toml": "^1.7.0",
    "valibot": "^1.4.2"
  }
}